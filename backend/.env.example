# AWS Profile
AWS_PROFILE=

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3006

# Resend
RESEND_API_KEY=

# Self-hosting on a custom domain: comma-separated list of extra allowed origins
# (CORS + Better Auth trusted origins), e.g. https://volunteers.example.org
ADDITIONAL_ALLOWED_ORIGINS=
