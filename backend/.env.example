# AWS Profile
AWS_PROFILE=

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Ports. Defaults are fine for a single checkout. Running a second instance
# at the same time (e.g. a second git worktree) needs its own PORT,
# FRONTEND_PORT, and BETTER_AUTH_URL — update all three together, and point
# DATABASE_URL at a separate Postgres too. See "Running multiple instances"
# in the README.
PORT=3006
FRONTEND_PORT=3001

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3006

# Resend
RESEND_API_KEY=

# Canonical public origin of the deployed app (CORS + Better Auth trusted origin).
# Production is same-origin, so set this to where users load the app,
# e.g. https://volunteers.example.org. Leave blank for local development.
APP_URL=

# Optional comma-separated list of extra allowed origins (raw CloudFront URL,
# staging, a second custom domain), e.g. https://staging.example.org
ADDITIONAL_ALLOWED_ORIGINS=
