# Docker Compose self-host configuration.
# Copy to .env and fill in values: cp .env.example .env
# (This file is for `docker compose`. For local non-Docker dev, use backend/.env instead.)

# REQUIRED: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public URL the app is served from. For local Compose, the default is fine.
BETTER_AUTH_URL=http://localhost:3006

# OPTIONAL: needed only for transactional email (Resend). Leave blank to disable.
RESEND_API_KEY=

# Postgres credentials (used by both the db container and the app's DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
